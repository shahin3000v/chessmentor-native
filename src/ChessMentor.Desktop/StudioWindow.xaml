<Window x:Class="ChessMentor.Desktop.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:board="clr-namespace:ChessMentor.Desktop.Controls"
        x:Name="StudioRoot"
        Title="ChessMentor Desktop — PGN Studio"
        Width="1540"
        Height="940"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="StudioPanel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE4E4E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="VirtualList" TargetType="ListBox">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF111827"
                CornerRadius="9"
                Padding="8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Command="{Binding ToggleHeaderCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TinyButton}">
                            <Setter Property="Content" Value="−" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeaderCollapsed}" Value="True">
                                    <Setter Property="Content" Value="+" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            FlowDirection="RightToLeft"
                            VerticalAlignment="Center"
                            Margin="10,0">
                    <TextBlock Text="PGN Studio"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <Border Background="#FF1F2937"
                            CornerRadius="10"
                            Margin="10,0"
                            Padding="8,3">
                        <TextBlock Text="{Binding CurrentFileName}"
                                   Foreground="#FFE5E7EB"
                                   FlowDirection="LeftToRight"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   MaxWidth="270"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock Text="{Binding CurrentDraftLabel}"
                               Foreground="#FFCBD5E1"
                               VerticalAlignment="Center" />
                    <Border Width="56"
                            Height="38"
                            Margin="8,0"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Visibility="{Binding HasFeaturedImage, Converter={StaticResource BoolVisibility}}">
                        <Image Source="{Binding FeaturedImagePath}"
                               Stretch="UniformToFill"
                               ToolTip="{Binding FeaturedImageName}" />
                    </Border>
                </StackPanel>
                <WrapPanel Grid.Column="2" FlowDirection="RightToLeft">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeaderCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <Button Content="باز کردن PGN" Click="OnOpenFilesClick" />
                    <Button Content="افزودن فایل" Click="OnAppendFilesClick" />
                    <Button Content="خروجی PGN" Click="OnExportPgnClick" />
                    <Button Content="تصویر شاخص…" Click="OnChooseFeaturedImageClick" />
                    <Button Content="حذف تصویر"
                            Click="OnClearFeaturedImageClick"
                            IsEnabled="{Binding HasFeaturedImage}" />
                    <Button Content="ذخیره Draft" Command="{Binding SaveLocalDraftCommand}" />
                    <ComboBox ItemsSource="{Binding LocalDrafts}"
                              SelectedItem="{Binding SelectedLocalDraft}"
                              DisplayMemberPath="Title"
                              Width="165"
                              Margin="3"
                              ToolTip="Draftهای محلی بر اساس آخرین تغییر" />
                    <Button Content="ادامه Draft" Command="{Binding ResumeLocalDraftCommand}" />
                    <Button Content="ترجمه" Command="{Binding TranslateCommand}" />
                    <Button Content="لغو ترجمه" Command="{Binding CancelTranslationCommand}" />
                    <ComboBox ItemsSource="{Binding TranslationConcurrencyOptions}"
                              SelectedItem="{Binding TranslationConcurrency}"
                              Width="54"
                              Margin="3"
                              FlowDirection="LeftToRight"
                              ToolTip="تعداد Workerهای هم‌زمان ترجمه" />
                    <Button Content="↻"
                            Style="{StaticResource TinyButton}"
                            Command="{Binding FlipBoardCommand}"
                            ToolTip="چرخاندن برد" />
                    <Button Content="⚙ تنظیمات"
                            Click="OnOpenSettingsClick"
                            ToolTip="تنظیم نمایش حرکات، فونت توضیحات و پوستهٔ برد" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="7"
                Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource StudioPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HeaderCollapsed}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Server API" FontWeight="SemiBold" />
                    <TextBox Text="{Binding ServerBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             FlowDirection="LeftToRight"
                             HorizontalContentAlignment="Left"
                             Margin="3"
                             ToolTip="آدرس FastAPI فعلی" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="اتصال" Command="{Binding ConnectCommand}" />
                    <Button Content="ورود" Click="OnLoginClick" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="عنوان Draft / دوره" FontWeight="SemiBold" />
                    <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}" Margin="3" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="دسته‌بندی" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Slug"
                              SelectedValue="{Binding CategorySlug}"
                              IsEditable="True"
                              Text="{Binding CategorySlug, UpdateSourceTrigger=PropertyChanged}"
                              Margin="3" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Slug / قیمت minor" FontWeight="SemiBold" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="68" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PublishSlug, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight"
                                 HorizontalContentAlignment="Left"
                                 Margin="3" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CreditPriceMinor, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight"
                                 HorizontalContentAlignment="Left"
                                 Margin="3"
                                 ToolTip="قیمت در کوچک‌ترین واحد اعتباری Server" />
                    </Grid>
                </StackPanel>
                <WrapPanel Grid.Column="5" VerticalAlignment="Bottom" FlowDirection="RightToLeft">
                    <TextBox Text="{Binding ServerDraftIdText, UpdateSourceTrigger=PropertyChanged}"
                             Width="76"
                             FlowDirection="LeftToRight"
                             ToolTip="Server Draft ID"
                             Margin="3" />
                    <Button Content="دریافت" Command="{Binding LoadServerDraftCommand}" />
                    <Button Content="Draft سرور" Command="{Binding SaveServerDraftCommand}" />
                    <Button Content="انتشار" Command="{Binding PublishCommand}" Background="#FFDCFCE7" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StudioMovesColumn"
                                  Width="{Binding StudioMovesColumnWidth}"
                                  MinWidth="300" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" MinWidth="430" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition x:Name="StudioGamesColumn"
                                  Width="{Binding StudioGamesColumnWidth}"
                                  MinWidth="230" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StudioPanel}" FlowDirection="RightToLeft">
                <TabControl BorderThickness="0">
                    <TabItem Header="حرکات و ویرایش">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="StudioMovesList"
                                     Grid.Row="0"
                                     Style="{StaticResource VirtualList}"
                                     ItemsSource="{Binding MoveRows}"
                                     SelectedItem="{Binding SelectedMoveRow, Mode=TwoWay}"
                                     SelectionChanged="OnMoveSelectionChanged"
                                     FlowDirection="LeftToRight">
                                <ListBox.Resources>
                                    <DataTemplate x:Key="StudioMoveCellTemplate">
                                        <Button Tag="{Binding}"
                                                Click="OnMoveCellClick"
                                                HorizontalContentAlignment="Left"
                                                BorderThickness="0"
                                                Padding="6,5"
                                                FocusVisualStyle="{x:Null}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="5"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#FFFEE2E2" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFF4F4F5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="ویرایش توضیحات"
                                                              CommandParameter="{Binding NodeId}"
                                                              Click="OnEditMoveCommentClick" />
                                                    <MenuItem Header="تبدیل به Mainline"
                                                              CommandParameter="{Binding NodeId}"
                                                              Click="OnPromoteMoveClick" />
                                                    <Separator />
                                                    <MenuItem Header="حذف کامل شاخه"
                                                              CommandParameter="{Binding NodeId}"
                                                              Foreground="#FFB91C1C"
                                                              Click="OnDeleteBranchClick" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                <TextBlock Text="↳"
                                                           Foreground="#FF94A3B8"
                                                           Margin="0,0,5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StartsVariation}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplaySan}"
                                                           FontFamily="Segoe UI Symbol, Consolas"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding NagText}"
                                                           Margin="7,0,0,0"
                                                           Foreground="#FFB45309"
                                                           FontFamily="Consolas" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                    <DataTemplate x:Key="StudioStartingCommentTemplate">
                                        <Grid HorizontalAlignment="Stretch"
                                              FlowDirection="LeftToRight">
                                            <board:MixedDirectionTextBlock MixedText="{Binding StartingComment}"
                                                                           FlowDirection="LeftToRight"
                                                                           TextAlignment="Right"
                                                                           HorizontalAlignment="Stretch"
                                                                           TextWrapping="Wrap"
                                                                           FontFamily="{Binding DataContext.CommentFontFamily, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                           FontSize="{Binding DataContext.CommentFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                           Foreground="#FF52525B"
                                                                           Margin="6,4">
                                                <board:MixedDirectionTextBlock.Style>
                                                    <Style TargetType="board:MixedDirectionTextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasStartingComment}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </board:MixedDirectionTextBlock.Style>
                                            </board:MixedDirectionTextBlock>
                                        </Grid>
                                    </DataTemplate>
                                    <DataTemplate x:Key="StudioCommentTemplate">
                                        <Grid HorizontalAlignment="Stretch"
                                              FlowDirection="LeftToRight">
                                            <Border Background="#FFFAFAFA"
                                                    BorderBrush="#FFEEEEEE"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="7,5"
                                                    Margin="6,3"
                                                    HorizontalAlignment="Stretch">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasComment}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <board:MixedDirectionTextBlock MixedText="{Binding Comment}"
                                                                               FlowDirection="LeftToRight"
                                                                               TextAlignment="Right"
                                                                               HorizontalAlignment="Stretch"
                                                                               TextWrapping="Wrap"
                                                                               FontFamily="{Binding DataContext.CommentFontFamily, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                               FontSize="{Binding DataContext.CommentFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                               Foreground="#FF27272A" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3,1"
                                                Padding="0,2"
                                                BorderBrush="#FFE5E7EB"
                                                BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StartsVariation}" Value="True">
                                                            <Setter Property="BorderThickness" Value="3,0,0,1" />
                                                            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid ClipToBounds="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Indent}" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                                                Content="{Binding WhiteMove}"
                                                                HorizontalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource StudioStartingCommentTemplate}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding MoveNumber}"
                                                           Padding="4,5"
                                                           Foreground="#FF71717A"
                                                           FontFamily="Consolas" />
                                                <ContentControl Grid.Row="1" Grid.Column="2"
                                                                Content="{Binding WhiteMove}"
                                                                ContentTemplate="{StaticResource StudioMoveCellTemplate}" />
                                                <ContentControl Grid.Row="1" Grid.Column="3"
                                                                Content="{Binding BlackMove}"
                                                                ContentTemplate="{StaticResource StudioMoveCellTemplate}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BlackOnNextLine}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <ContentControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                                                Content="{Binding WhiteMove}"
                                                                HorizontalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource StudioCommentTemplate}" />
                                                <ContentControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                                                                Content="{Binding BlackMove}"
                                                                HorizontalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource StudioStartingCommentTemplate}" />
                                                <ContentControl Grid.Row="4" Grid.Column="3"
                                                                Content="{Binding BlackMove}"
                                                                ContentTemplate="{StaticResource StudioMoveCellTemplate}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BlackOnNextLine}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <ContentControl Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                                                                Content="{Binding BlackMove}"
                                                                HorizontalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource StudioCommentTemplate}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="1"
                                    BorderBrush="#FFE4E4E7"
                                    BorderThickness="0,1,0,0"
                                    Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentMoveLabel}"
                                               FlowDirection="LeftToRight"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="توضیح قبل از حرکت" Margin="0,5,0,2" />
                                    <TextBox Text="{Binding StartingCommentEditor, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="{Binding CommentFontFamily}"
                                             FontSize="{Binding CommentFontSize}"
                                             MinHeight="50"
                                             VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="توضیح حرکت" Margin="0,5,0,2" />
                                    <TextBox x:Name="CommentEditorBox"
                                             Text="{Binding CommentEditor, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="{Binding CommentFontFamily}"
                                             FontSize="{Binding CommentFontSize}"
                                             MinHeight="80"
                                             MaxHeight="150"
                                             VerticalScrollBarVisibility="Auto" />
                                    <WrapPanel Margin="0,5,0,0">
                                        <Button Content="اعمال توضیحات" Command="{Binding ApplyCommentsCommand}" />
                                        <Button Content="Mainline" Command="{Binding PromoteBranchCommand}" />
                                        <Button Content="حذف شاخه" Click="OnDeleteCurrentBranchClick" Foreground="#FFB91C1C" />
                                    </WrapPanel>
                                    <Separator Margin="0,7,0,5" />
                                    <TextBlock Text="صدای متصل به همین حرکت"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding AudioItems}"
                                              SelectedItem="{Binding SelectedAudio}"
                                              DisplayMemberPath="Label"
                                              MinWidth="210"
                                              Margin="3" />
                                    <WrapPanel FlowDirection="RightToLeft">
                                        <Button Content="ضبط عمومی"
                                                Command="{Binding RecordCourseAudioCommand}"
                                                ToolTip="Teacher/Public scope" />
                                        <Button Content="ضبط شخصی"
                                                Command="{Binding RecordUserAudioCommand}"
                                                ToolTip="User/Private scope" />
                                        <Button Content="پایان ضبط"
                                                Command="{Binding StopRecordingCommand}" />
                                        <Button Content="{Binding AudioPlayLabel}"
                                                Command="{Binding PlayAudioCommand}" />
                                        <Button Content="حذف صدا"
                                                Click="OnDeleteAudioClick"
                                                IsEnabled="{Binding CanDeleteSelectedAudio}"
                                                Foreground="#FFB91C1C" />
                                    </WrapPanel>
                                    <Slider Minimum="0"
                                            Maximum="{Binding AudioDurationMaximum}"
                                            Value="{Binding AudioPositionMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            FlowDirection="LeftToRight"
                                            Margin="3" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding RecordingStatus}"
                                                   Foreground="#FFB91C1C" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AudioTimeLabel}"
                                                   FlowDirection="LeftToRight"
                                                   FontFamily="Consolas" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Headers">
                        <ListBox Style="{StaticResource VirtualList}" ItemsSource="{Binding GameHeaders}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="7" FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Translation DB">
                        <Grid Margin="7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding TranslationCacheSearch, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="جست‌وجو در متن مبدأ یا ترجمه" />
                                <Button Grid.Column="1"
                                        Content="جست‌وجو"
                                        Command="{Binding SearchTranslationCacheCommand}" />
                            </Grid>
                            <ListBox Grid.Row="1"
                                     Style="{StaticResource VirtualList}"
                                     ItemsSource="{Binding TranslationCacheRows}"
                                     SelectedItem="{Binding SelectedTranslationCacheEntry, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2"
                                                Padding="6"
                                                BorderBrush="#FFE4E4E7"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SourceText}"
                                                           FlowDirection="LeftToRight"
                                                           TextWrapping="Wrap"
                                                           FontFamily="Segoe UI, Consolas"
                                                           Foreground="#FF3F3F46" />
                                                <TextBlock Text="{Binding TranslatedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                                <StackPanel Orientation="Horizontal"
                                                            FlowDirection="LeftToRight"
                                                            Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="#FF71717A"
                                                               FontSize="10" />
                                                    <TextBlock Text="  ·  " Foreground="#FFA1A1AA" />
                                                    <TextBlock Text="{Binding PhraseIdentity}"
                                                               Foreground="#FFA1A1AA"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="190" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="2"
                                    BorderBrush="#FFE4E4E7"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,7,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedTranslationCacheEntry.SourceText}"
                                               FlowDirection="LeftToRight"
                                               TextWrapping="Wrap"
                                               Foreground="#FF52525B"
                                               MaxHeight="75" />
                                    <TextBox Text="{Binding TranslationCacheEditor, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="72"
                                             MaxHeight="130"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,6,0,3" />
                                    <Button Content="اعمال و همگام‌سازی"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ApplyTranslationCacheEditCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="7"
                          HorizontalAlignment="Stretch"
                          Background="#FFD4D4D8"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnSplitterDragCompleted" />

            <Border Grid.Column="2" Style="{StaticResource StudioPanel}" Padding="8">
                <Grid FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding TopPlayerName}"
                               FontWeight="SemiBold"
                               Margin="4"
                               HorizontalAlignment="Center" />
                    <Grid Grid.Row="1">
                        <board:ChessBoardControl x:Name="StudioBoard"
                                                 Position="{Binding BoardFen}"
                                                 Skin="{Binding SelectedSkin}"
                                                 Orientation="{Binding Orientation}"
                                                 ShowCoordinates="{Binding ShowCoordinates}"
                                                 Overlay="{Binding BoardOverlay}"
                                                 LegalMoves="{Binding LegalMoves}"
                                                 MoveRequested="OnMoveRequested"
                                                 RenderCompleted="OnRenderCompleted"
                                                 PositionRejected="OnPositionRejected"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch" />
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="8"
                                Padding="7"
                                Background="#F7FFFFFF"
                                BorderBrush="#FFB45309"
                                BorderThickness="1"
                                CornerRadius="7"
                                Visibility="{Binding IsBranchChooserOpen, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Width="190">
                                <TextBlock Text="انتخاب شاخه" FontWeight="SemiBold" Margin="3" />
                                <ListBox x:Name="StudioBranchList"
                                         ItemsSource="{Binding Branches}"
                                         SelectedItem="{Binding SelectedBranch}"
                                         MaxHeight="230"
                                         DisplayMemberPath="Label" />
                                <Button Content="انتخاب" Command="{Binding ChooseBranchCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="3,7,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding BottomPlayerName}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                BorderBrush="#FFD4D4D8"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3">
                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                <Button Content="|◀" Command="{Binding PreviousGameCommand}" Style="{StaticResource TinyButton}" />
                                <Button Content="◀" Command="{Binding PreviousMoveCommand}" Style="{StaticResource TinyButton}" />
                                <Button Content="▶" Command="{Binding NextMoveCommand}" Style="{StaticResource TinyButton}" />
                                <Button Content="▶|" Command="{Binding NextGameCommand}" Style="{StaticResource TinyButton}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentMoveLabel}"
                                   FlowDirection="LeftToRight"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          Width="7"
                          HorizontalAlignment="Stretch"
                          Background="#FFD4D4D8"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="OnSplitterDragCompleted" />

            <Border Grid.Column="4" Style="{StaticResource StudioPanel}" FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="بازی‌ها" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    FlowDirection="RightToLeft">
                            <Button Content="حذف انتخاب‌ها"
                                    Click="OnRemoveMarkedGamesClick"
                                    Padding="7,2"
                                    Margin="5,0"
                                    Foreground="#FFB91C1C" />
                            <TextBlock Text="{Binding GameCount}"
                                       FlowDirection="LeftToRight"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1"
                             Style="{StaticResource VirtualList}"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             SelectionChanged="OnGameSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,2"
                                        Padding="6"
                                        BorderBrush="#FFE4E4E7"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsMarked}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="6,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FlowDirection="LeftToRight"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Result}"
                                                       FlowDirection="LeftToRight"
                                                       FontFamily="Consolas"
                                                       Foreground="#FF71717A" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="🗑"
                                                Tag="{Binding}"
                                                Click="OnRemoveGameClick"
                                                Style="{StaticResource TinyButton}"
                                                Foreground="#FFB91C1C" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Style="{StaticResource StudioPanel}"
                Padding="8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding TranslationMessage}" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding TranslationPercentage, Mode=OneWay}"
                                 Height="7"
                                 Margin="0,5,8,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TranslationCompleted}" FontFamily="Consolas" />
                    <TextBlock Text=" / " />
                    <TextBlock Text="{Binding TranslationTotal}" FontFamily="Consolas" />
                    <TextBlock Text=" — " />
                    <TextBlock Text="{Binding TranslationPercentage}" FontFamily="Consolas" />
                    <TextBlock Text="%" />
                    <TextBlock Text="  · خطا " Foreground="#FFB91C1C" />
                    <TextBlock Text="{Binding TranslationFailed}" Foreground="#FFB91C1C" FontFamily="Consolas" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="#FF27272A"
                CornerRadius="7"
                Padding="7"
                Margin="0,7,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="White" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight">
                    <TextBlock Text="{Binding AuthStatus}" Foreground="#FF86EFAC" Margin="8,0" />
                    <TextBlock Text="Parse " Foreground="#FFA1A1AA" />
                    <TextBlock Text="{Binding Metrics.PgnParseMilliseconds, StringFormat={}{0:F1}ms}" Foreground="White" FontFamily="Consolas" />
                    <TextBlock Text="  DB " Foreground="#FFA1A1AA" />
                    <TextBlock Text="{Binding Metrics.DatabaseMilliseconds, StringFormat={}{0:F1}ms}" Foreground="White" FontFamily="Consolas" />
                    <TextBlock Text="  Nodes " Foreground="#FFA1A1AA" />
                    <TextBlock Text="{Binding NodeCount}" Foreground="White" FontFamily="Consolas" />
                    <TextBlock Text="  Sync " Foreground="#FFA1A1AA" />
                    <TextBlock Text="{Binding SyncQueueCount}" Foreground="White" FontFamily="Consolas" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
