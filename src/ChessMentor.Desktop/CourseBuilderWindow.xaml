<Window x:Class="ChessMentor.Desktop.CourseBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:board="clr-namespace:ChessMentor.Desktop.Controls"
        Title="ChessMentor Desktop — Course Builder"
        Width="1000"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE4E4E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="VirtualList" TargetType="ListBox">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF111827" CornerRadius="10" Padding="9" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Course Builder Native" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox Width="240" Margin="14,0,0,0"
                              ItemsSource="{Binding Documents}"
                              SelectedItem="{Binding SelectedDocument}"
                              DisplayMemberPath="Title"
                              SelectionChanged="OnDocumentSelectionChanged" />
                </StackPanel>
                <WrapPanel Grid.Column="1" FlowDirection="RightToLeft">
                    <Button Content="سند جدید" Command="{Binding NewDocumentCommand}" />
                    <Button Content="باز کردن PGN…" Click="OnOpenPgnClick" />
                    <Button Content="ذخیره" Command="{Binding SaveCommand}" Background="#FFBBF7D0" />
                    <Button Content="Undo" Command="{Binding UndoCommand}" />
                    <Button Content="Redo" Command="{Binding RedoCommand}" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourcesColumn" Width="0.8*" MinWidth="150" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="CanvasColumn" Width="1.25*" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="InspectorColumn" Width="1*" MinWidth="190" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="PreviewColumn" Width="1.35*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Sources" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Games · Moves · Comments · Positions · Variations"
                                   FontSize="10" Foreground="#FF64748B" FlowDirection="LeftToRight" Margin="0,3,0,8" />
                    </StackPanel>
                    <ListBox x:Name="SourcesList"
                             Grid.Row="1"
                             ItemsSource="{Binding Sources}"
                             Style="{StaticResource VirtualList}"
                             PreviewMouseLeftButtonDown="OnSourceMouseLeftButtonDown"
                             PreviewMouseMove="OnSourceMouseMove"
                             MouseDoubleClick="OnSourceDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF8FAFC" CornerRadius="7" Padding="8" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="#FF2563EB" FlowDirection="LeftToRight" />
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Right" MaxHeight="64" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Course Canvas" FontSize="17" FontWeight="SemiBold" />
                        <TextBox Text="{Binding CourseTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,8" />
                        <WrapPanel>
                            <Button Content="+ Text" Command="{Binding AddTextCommand}" />
                            <Button Content="+ Position" Command="{Binding AddPositionCommand}" />
                            <Button Content="+ Interactive" Command="{Binding AddInteractiveMoveCommand}" />
                            <Button Content="+ Stage" Command="{Binding AddStageCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="CanvasList"
                             Grid.Row="1"
                             Margin="0,8,0,0"
                             ItemsSource="{Binding Blocks}"
                             SelectedItem="{Binding SelectedBlock}"
                             Style="{StaticResource VirtualList}"
                             AllowDrop="True"
                             Drop="OnCanvasDrop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1"
                                        CornerRadius="8" Padding="9" Margin="0,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Badge}" Foreground="#FFB45309" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Row="0" Grid.Column="1" Background="#FFE0E7FF" CornerRadius="10" Padding="7,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Kind}" FontSize="10" FlowDirection="LeftToRight" />
                                        </Border>
                                        <board:ChessBoardControl Grid.Row="1" Grid.ColumnSpan="2"
                                                                 Width="150" Height="150" Margin="0,8,0,0"
                                                                 HorizontalAlignment="Center"
                                                                 Position="{Binding Fen}"
                                                                 Skin="{Binding DataContext.SelectedSkin, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 ShowCoordinates="False">
                                            <board:ChessBoardControl.Style>
                                                <Style TargetType="board:ChessBoardControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBoardBlock}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </board:ChessBoardControl.Style>
                                        </board:ChessBoardControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Panel}" FlowDirection="RightToLeft">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Inspector" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="عنوان Block" Margin="0,12,0,4" />
                        <TextBox Text="{Binding BlockTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="محتوا" Margin="0,12,0,4" />
                        <TextBox Text="{Binding BlockText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" TextAlignment="Right" MinHeight="120" />
                        <TextBlock Text="FEN" Margin="0,12,0,4" />
                        <TextBox Text="{Binding BlockFen, UpdateSourceTrigger=LostFocus}"
                                 FlowDirection="LeftToRight" FontFamily="Consolas" TextWrapping="Wrap" />
                        <Separator Margin="0,14" />
                        <CheckBox Content="▶ Play / Auto advance"
                                  IsChecked="{Binding HasAutoAdvance}" FlowDirection="LeftToRight" />
                        <StackPanel IsEnabled="{Binding HasAutoAdvance}" Margin="0,6,0,0">
                            <TextBlock Text="زمان (ثانیه)" />
                            <TextBox Text="{Binding AutoAdvanceSeconds, UpdateSourceTrigger=LostFocus}"
                                     FlowDirection="LeftToRight" />
                        </StackPanel>
                        <Separator Margin="0,14" />
                        <TextBlock Text="LEGO — اتصال Text به Target" />
                        <ComboBox ItemsSource="{Binding AttachmentTargets}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding AttachmentTargetId, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,5,0,0" />
                        <Button Content="Detach" Margin="0,5,0,0" Click="OnDetachClick" />
                        <Separator Margin="0,14" />
                        <WrapPanel>
                            <Button Content="بالا" Command="{Binding MoveUpCommand}" />
                            <Button Content="پایین" Command="{Binding MoveDownCommand}" />
                            <Button Content="Duplicate" Command="{Binding DuplicateCommand}" />
                            <Button Content="حذف" Command="{Binding DeleteCommand}" Foreground="#FFB91C1C" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource Panel}" FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Preview" FontSize="17" FontWeight="SemiBold" />
                    <Border Grid.Row="1" Background="#FFF8FAFC" CornerRadius="8" Padding="9" Margin="0,8">
                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" TextAlignment="Right" MinHeight="52" />
                    </Border>
                    <Viewbox Grid.Row="2" Stretch="Uniform">
                        <board:ChessBoardControl Width="620" Height="620"
                                                 Position="{Binding PreviewFen}"
                                                 Skin="{Binding SelectedSkin}"
                                                 ShowCoordinates="{Binding ShowCoordinates}"
                                                 PositionRejected="OnPositionRejected" />
                    </Viewbox>
                    <Border Grid.Row="3" Background="#FFF8FAFC" CornerRadius="8" Padding="9" Margin="0,8,0,0">
                        <TextBlock Text="{Binding PreviewStages}" TextAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF18181B" CornerRadius="8" Padding="9" Margin="0,9,0,0">
            <TextBlock Text="{Binding Status}" Foreground="#FFF4F4F5" TextWrapping="Wrap" TextAlignment="Right" />
        </Border>
    </Grid>
</Window>
