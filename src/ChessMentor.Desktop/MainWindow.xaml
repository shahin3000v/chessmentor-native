<Window x:Class="ChessMentor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:board="clr-namespace:ChessMentor.Desktop.Controls"
        x:Name="RootWindow"
        Title="ChessMentor Desktop — Viewer 1"
        Width="1000"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="#FFE4E4E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="MoveListStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrainingMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TurnDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="#FF16A34A" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF111827"
                CornerRadius="10"
                Padding="10"
                Margin="0,0,0,10"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding ToggleHeaderCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CompactIconButton}">
                            <Setter Property="Content" Value="−" />
                            <Setter Property="ToolTip" Value="جمع کردن هدر" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeaderCollapsed}" Value="True">
                                    <Setter Property="Content" Value="+" />
                                    <Setter Property="ToolTip" Value="باز کردن هدر" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            FlowDirection="RightToLeft">
                    <TextBlock Text="PGN Persian Chess Studio"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="#FF1F2937"
                            BorderBrush="#FF4B5563"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="12,0"
                            Padding="9,3"
                            FlowDirection="LeftToRight">
                        <TextBlock Text="{Binding CurrentFileName}"
                                   Foreground="#FFE5E7EB"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   MaxWidth="330"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>

                <WrapPanel Grid.Column="2"
                           FlowDirection="RightToLeft"
                           VerticalAlignment="Center">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeaderCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <Button Content="باز کردن PGN"
                            Click="OnOpenFilesClick"
                            IsEnabled="{Binding CanOpenFiles}"
                            ToolTip="باز کردن یک یا چند فایل و جایگزینی Workspace" />
                    <Button Content="افزودن فایل"
                            Click="OnAppendFilesClick"
                            IsEnabled="{Binding CanOpenFiles}"
                            ToolTip="افزودن بازی‌های فایل جدید بدون parse دوباره فایل‌های قبلی" />
                    <Button Content="PGN Studio"
                            Click="OnOpenStudioClick"
                            IsEnabled="{Binding CanOpenFiles}"
                            Background="#FFFDE68A"
                            ToolTip="باز کردن Studio Native برای ویرایش، ترجمه، Draft و Publish" />
                    <Button Content="MoveTrainer"
                            Click="OnOpenMoveTrainerClick"
                            IsEnabled="{Binding CanOpenFiles}"
                            Background="#FFBBF7D0"
                            ToolTip="ساخت دوره تمرینی، FSRS، مرور روزانه و Retry Mistakes" />
                    <Button Content="Course Builder"
                            Click="OnOpenCourseBuilderClick"
                            IsEnabled="{Binding CanOpenFiles}"
                            Background="#FFC7D2FE"
                            ToolTip="ساخت Native دوره با Sources، Canvas، Inspector و Preview" />
                    <Button Content="ارتقای دیتابیس…"
                            Click="OnUpgradeDatabaseClick"
                            IsEnabled="{Binding CanOpenFiles}"
                            ToolTip="انتخاب و ادغام یک دیتابیس SQLite سازگار ChessMentor" />
                    <Button Content="پاک کردن"
                            Command="{Binding ClearCommand}" />
                    <Button Content="↻"
                            Style="{StaticResource CompactIconButton}"
                            Command="{Binding FlipBoardCommand}"
                            ToolTip="چرخاندن برد" />
                    <Button Content="⚙ تنظیمات"
                            Click="OnOpenSettingsClick"
                            ToolTip="تنظیم نمایش حرکات، فونت توضیحات و پوستهٔ برد" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid x:Name="ViewerGrid" Grid.Row="1" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MovesColumn" Width="{Binding MovesColumnWidth}" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition x:Name="GamesSplitterColumn" Width="{Binding GamesSplitterWidth}" />
                <ColumnDefinition x:Name="GamesColumn" Width="{Binding GamesColumnWidth}" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" FlowDirection="RightToLeft">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabItem Header="حرکات و شاخه‌ها">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#FFFAFAFA"
                                    BorderBrush="#FFEEEEEE"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    Margin="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasRootComment}" Value="True" />
                                                    <Condition Binding="{Binding IsAllMovesMode}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <board:MixedDirectionTextBlock MixedText="{Binding RootComment}"
                                           FlowDirection="LeftToRight"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           FontFamily="{Binding CommentFontFamily}"
                                           FontSize="{Binding CommentFontSize}" />
                            </Border>
                            <ListBox x:Name="MovesList"
                                     Grid.Row="1"
                                     Style="{StaticResource MoveListStyle}"
                                     ItemsSource="{Binding MoveRows}"
                                     SelectedItem="{Binding SelectedMoveRow, Mode=TwoWay}"
                                     SelectionChanged="OnMoveSelectionChanged">
                                <ListBox.Resources>
                                    <DataTemplate x:Key="ViewerMoveCellTemplate">
                                        <Button Tag="{Binding}"
                                                Click="OnMoveCellClick"
                                                HorizontalContentAlignment="Left"
                                                BorderThickness="0"
                                                Padding="6,5"
                                                FocusVisualStyle="{x:Null}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="5"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#FFFEE2E2" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFF4F4F5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                                <TextBlock Text="↳"
                                                           Foreground="#FF94A3B8"
                                                           Margin="0,0,5,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StartsVariation}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplaySan}"
                                                           FontFamily="Segoe UI Symbol, Consolas"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding NagText}"
                                                           Margin="7,0,0,0"
                                                           Foreground="#FFB45309"
                                                           FontFamily="Consolas" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                    <DataTemplate x:Key="ViewerStartingCommentTemplate">
                                        <Grid HorizontalAlignment="Stretch"
                                              FlowDirection="LeftToRight">
                                            <board:MixedDirectionTextBlock MixedText="{Binding StartingComment}"
                                                                           FlowDirection="LeftToRight"
                                                                           TextAlignment="Right"
                                                                           HorizontalAlignment="Stretch"
                                                                           TextWrapping="Wrap"
                                                                           FontFamily="{Binding DataContext.CommentFontFamily, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                           FontSize="{Binding DataContext.CommentFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                           Foreground="#FF52525B"
                                                                           Margin="6,4">
                                                <board:MixedDirectionTextBlock.Style>
                                                    <Style TargetType="board:MixedDirectionTextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasStartingComment}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.IsAllMovesMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </board:MixedDirectionTextBlock.Style>
                                            </board:MixedDirectionTextBlock>
                                        </Grid>
                                    </DataTemplate>
                                    <DataTemplate x:Key="ViewerCommentTemplate">
                                        <Grid HorizontalAlignment="Stretch"
                                              FlowDirection="LeftToRight">
                                            <Border Background="#FFFAFAFA"
                                                    BorderBrush="#FFEEEEEE"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="7,5"
                                                    Margin="6,3"
                                                    HorizontalAlignment="Stretch">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasComment}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.IsAllMovesMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <board:MixedDirectionTextBlock MixedText="{Binding Comment}"
                                                                               FlowDirection="LeftToRight"
                                                                               TextAlignment="Right"
                                                                               HorizontalAlignment="Stretch"
                                                                               TextWrapping="Wrap"
                                                                               FontFamily="{Binding DataContext.CommentFontFamily, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                               FontSize="{Binding DataContext.CommentFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                               Foreground="#FF27272A" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3,1"
                                                Padding="0,2"
                                                BorderBrush="#FFE5E7EB"
                                                BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StartsVariation}" Value="True">
                                                            <Setter Property="BorderThickness" Value="3,0,0,1" />
                                                            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid ClipToBounds="True" FlowDirection="LeftToRight">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Indent}" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                                                Content="{Binding WhiteMove}"
                                                                HorizontalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource ViewerStartingCommentTemplate}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding MoveNumber}"
                                                           Padding="4,5"
                                                           Foreground="#FF71717A"
                                                           FontFamily="Consolas" />
                                                <ContentControl Grid.Row="1" Grid.Column="2"
                                                                Content="{Binding WhiteMove}"
                                                                ContentTemplate="{StaticResource ViewerMoveCellTemplate}" />
                                                <ContentControl Grid.Row="1" Grid.Column="3"
                                                                Content="{Binding BlackMove}"
                                                                ContentTemplate="{StaticResource ViewerMoveCellTemplate}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding BlackOnNextLine}" Value="True" />
                                                                        <Condition Binding="{Binding DataContext.IsAllMovesMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <ContentControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                                                Content="{Binding WhiteMove}"
                                                                HorizontalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource ViewerCommentTemplate}" />
                                                <ContentControl Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                                                                Content="{Binding BlackMove}"
                                                                HorizontalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource ViewerStartingCommentTemplate}" />
                                                <ContentControl Grid.Row="4" Grid.Column="3"
                                                                Content="{Binding BlackMove}"
                                                                ContentTemplate="{StaticResource ViewerMoveCellTemplate}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding BlackOnNextLine}" Value="True" />
                                                                        <Condition Binding="{Binding DataContext.IsAllMovesMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <ContentControl Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                                                                Content="{Binding BlackMove}"
                                                                HorizontalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource ViewerCommentTemplate}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Margin="12"
                                    Grid.RowSpan="2"
                                    Padding="14"
                                    Background="#FFFAFAFA"
                                    BorderBrush="#FFE4E4E7"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTrainingMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="حالت تمرین"
                                               Foreground="#FF71717A"
                                               Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding CurrentMoveLabel}"
                                               FlowDirection="LeftToRight"
                                               FontFamily="Consolas, Segoe UI Symbol"
                                               FontSize="18"
                                               FontWeight="Bold" />
                                    <board:ProgressiveCommentControl MixedText="{Binding ActiveStartingComment}"
                                                                     CommentFontFamily="{Binding CommentFontFamily}"
                                                                     CommentFontSize="{Binding CommentFontSize}"
                                                                     Margin="0,12,0,0" />
                                    <board:ProgressiveCommentControl MixedText="{Binding ActiveComment}"
                                                                     CommentFontFamily="{Binding CommentFontFamily}"
                                                                     CommentFontSize="{Binding CommentFontSize}"
                                                                     Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="اطلاعات بازی">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <ItemsControl ItemsSource="{Binding GameHeaders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="Consolas"
                                                       Foreground="#FF71717A" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       TextWrapping="Wrap"
                                                       FlowDirection="LeftToRight" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter x:Name="MovesSplitter"
                          Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          DragCompleted="OnSplitterDragCompleted" />

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,4,7" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource TurnDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTopSideToMove}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding TopPlayerName}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding TopPlayerElo}" Foreground="#FF71717A" FlowDirection="LeftToRight" />
                    </Grid>

                    <board:ChessBoardControl x:Name="NativeBoard"
                                             Grid.Row="1"
                                             FlowDirection="LeftToRight"
                                             Position="{Binding BoardFen}"
                                             Skin="{Binding SelectedSkin}"
                                             Orientation="{Binding Orientation}"
                                             ShowCoordinates="{Binding ShowCoordinates}"
                                             Overlay="{Binding BoardOverlay}"
                                             LegalMoves="{Binding LegalMoves}"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             MoveRequested="OnMoveRequested"
                                             RenderCompleted="OnRenderCompleted"
                                             PositionRejected="OnPositionRejected" />

                    <Grid Grid.Row="2" Margin="4,7,4,0" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource TurnDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBottomSideToMove}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding BottomPlayerName}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{Binding BottomPlayerElo}" Foreground="#FF71717A" FlowDirection="LeftToRight" />
                    </Grid>

                    <Border Grid.Row="3"
                            Background="#FFFAFAFA"
                            BorderBrush="#FFE4E4E7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMobileMode}" Value="True" />
                                            <Condition Binding="{Binding HasActiveComment}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentMoveLabel}"
                                       FlowDirection="LeftToRight"
                                       FontFamily="Consolas, Segoe UI Symbol"
                                       FontWeight="Bold" />
                            <board:ProgressiveCommentControl MixedText="{Binding ActiveStartingComment}"
                                                             CommentFontFamily="{Binding CommentFontFamily}"
                                                             CommentFontSize="{Binding CommentFontSize}"
                                                             MaxHeight="70"
                                                             Margin="0,5,0,0" />
                            <board:ProgressiveCommentControl MixedText="{Binding ActiveComment}"
                                                             CommentFontFamily="{Binding CommentFontFamily}"
                                                             CommentFontSize="{Binding CommentFontSize}"
                                                             MaxHeight="110" />
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="4"
                                 Columns="5"
                                 Margin="0,10,0,0"
                                 FlowDirection="LeftToRight">
                        <Button Style="{StaticResource NavigationButton}" Content="|◀" Command="{Binding PreviousGameCommand}" Click="OnNavigationButtonClick" ToolTip="بازی قبل (Home)" />
                        <Button Style="{StaticResource NavigationButton}" Content="◀" Command="{Binding PreviousMoveCommand}" Click="OnNavigationButtonClick" ToolTip="حرکت قبل (←)" />
                        <Button Style="{StaticResource NavigationButton}" Content="●" Command="{Binding MainlineCommand}" Click="OnNavigationButtonClick" ToolTip="شاخهٔ اصلی" />
                        <Button Style="{StaticResource NavigationButton}" Content="▶" Command="{Binding NextMoveCommand}" Click="OnNavigationButtonClick" ToolTip="حرکت بعد یا انتخاب شاخه (→)" />
                        <Button Style="{StaticResource NavigationButton}" Content="▶|" Command="{Binding NextGameCommand}" Click="OnNavigationButtonClick" ToolTip="بازی بعد (End)" />
                    </UniformGrid>
                </Grid>
            </Border>

            <GridSplitter x:Name="GamesSplitter"
                          Grid.Column="3"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"
                          DragCompleted="OnSplitterDragCompleted" />

            <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}" FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8" FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GameCount, StringFormat='بازی‌ها ({0})'}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GamesPanelCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Command="{Binding ToggleGamesPanelCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CompactIconButton}">
                                    <Setter Property="Content" Value="−" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GamesPanelCollapsed}" Value="True">
                                            <Setter Property="Content" Value="+" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GamesPanelCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <CheckBox x:Name="SelectAllGames" Content="انتخاب همه" Click="OnSelectAllGamesClick" VerticalAlignment="Center" />
                        <Button Content="حذف انتخاب‌شده" Click="OnRemoveMarkedGamesClick" MinWidth="110" Padding="8,4" />
                    </StackPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             SelectionChanged="OnGameSelectionChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             FlowDirection="LeftToRight"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GamesPanelCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsMarked}"
                                              VerticalAlignment="Center"
                                              Margin="6" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               FlowDirection="LeftToRight" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Result}"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               Foreground="#FF52525B"
                                               VerticalAlignment="Center"
                                               Margin="7,0" />
                                    <Button Grid.Column="3"
                                            Content="×"
                                            Tag="{Binding}"
                                            Click="OnRemoveGameClick"
                                            MinWidth="28"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            ToolTip="حذف بازی" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Panel.ZIndex="50"
                    Background="#66000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBranchChooserOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="430"
                        MaxHeight="560"
                        Padding="18"
                        Background="White"
                        CornerRadius="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FlowDirection="RightToLeft">
                    <StackPanel>
                        <TextBlock Text="انتخاب شاخه" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="ادامهٔ دلخواه را انتخاب کنید؛ شاخهٔ اول مسیر اصلی است."
                                   Foreground="#FF71717A"
                                   Margin="0,4,0,12" />
                        <ListBox x:Name="BranchList"
                                 ItemsSource="{Binding Branches}"
                                 SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                                 MaxHeight="390"
                                 FlowDirection="LeftToRight"
                                 MouseLeftButtonUp="OnBranchMouseLeftButtonUp"
                                 PreviewMouseWheel="OnBranchPreviewMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6" FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="▶" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontFamily="Consolas, Segoe UI Symbol" FontWeight="Bold" />
                                        <TextBlock Grid.Column="2" Text="شاخه اصلی" Foreground="{StaticResource AccentBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMainline}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                            <Button Content="ادامه" Command="{Binding ChooseBranchCommand}" />
                            <Button Content="انصراف" Command="{Binding CloseBranchChooserCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource PanelBorderStyle}"
                Margin="0,10,0,0"
                Padding="10,7">
            <DockPanel LastChildFill="True">
                <Expander DockPanel.Dock="Left"
                          Header="Debug / Benchmark"
                          Width="285"
                          FlowDirection="LeftToRight">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="PGN parse" />
                        <TextBlock Grid.Column="1" Text="{Binding Metrics.PgnParseMilliseconds, StringFormat={}{0:F2} ms}" FontFamily="Consolas" />
                        <TextBlock Grid.Row="1" Text="Semantic UCI/FEN" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Metrics.PgnSemanticMilliseconds, StringFormat={}{0:F2} ms}" FontFamily="Consolas" />
                        <TextBlock Grid.Row="2" Text="Games / nodes" />
                        <TextBlock Grid.Row="2" Grid.Column="1" FontFamily="Consolas"><Run Text="{Binding Metrics.GameCount}" /><Run Text=" / " /><Run Text="{Binding Metrics.NodeCount}" /></TextBlock>
                        <TextBlock Grid.Row="3" Text="Board render" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Metrics.RenderMilliseconds, StringFormat={}{0:F2} ms}" FontFamily="Consolas" />
                        <TextBlock Grid.Row="4" Text="DB query/init" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Metrics.DatabaseMilliseconds, StringFormat={}{0:F2} ms}" FontFamily="Consolas" />
                        <TextBlock Grid.Row="5" Text="Managed memory" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MemoryMegabytes, StringFormat={}{0:F1} MB}" FontFamily="Consolas" />
                    </Grid>
                </Expander>
                <TextBlock Text="{Binding Status}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,0"
                           FlowDirection="RightToLeft" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
