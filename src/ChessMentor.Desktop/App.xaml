<Application x:Class="ChessMentor.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#FFF7F2E9" />
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF765338" />
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma" />
            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
    </Application.Resources>
</Application>
