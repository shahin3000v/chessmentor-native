<Window x:Class="ChessMentor.Desktop.MoveTrainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:board="clr-namespace:ChessMentor.Desktop.Controls"
        Title="ChessMentor Desktop — MoveTrainer"
        Width="1000"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft">
    <Window.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE4E4E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style x:Key="VirtualList" TargetType="ListBox">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF111827" CornerRadius="10" Padding="9" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MoveTrainer Native" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <Border Background="#FF1F2937" CornerRadius="12" Margin="12,0" Padding="10,3">
                        <TextBlock Text="{Binding Progress}" Foreground="#FF93C5FD" FlowDirection="LeftToRight" />
                    </Border>
                </StackPanel>
                <WrapPanel Grid.Column="1" FlowDirection="RightToLeft">
                    <Button Content="باز کردن PGN…" Click="OnOpenPgnClick" IsEnabled="{Binding IsAuthoring}" />
                    <Button Content="ذخیره دوره" Command="{Binding SaveCourseCommand}" />
                    <Button Content="شروع تمرین روزانه" Command="{Binding StartTrainingCommand}" Background="#FFBBF7D0" />
                    <Button Content="ادامه جلسه" Command="{Binding ResumeTrainingCommand}" />
                    <Button Content="Retry Mistakes" Command="{Binding RetryMistakesCommand}" />
                    <Button Content="پایان تمرین" Command="{Binding StopTrainingCommand}" />
                    <Button Content="↻" Command="{Binding FlipBoardCommand}" ToolTip="چرخاندن برد" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="190" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="1.7*" MinWidth="320" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="1*" MinWidth="210" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" FlowDirection="RightToLeft">
                <TabControl BorderThickness="0">
                    <TabItem Header="دوره‌ها">
                        <ListBox ItemsSource="{Binding Courses}"
                                 Style="{StaticResource VirtualList}"
                                 IsEnabled="{Binding IsAuthoring}"
                                 SelectionChanged="OnCourseSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,2" Background="#FFF8FAFC" CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#FF64748B" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="موقعیت‌ها">
                        <ListBox ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedEditor}"
                                 Style="{StaticResource VirtualList}"
                                 IsEnabled="{Binding IsAuthoring}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="7" Margin="0,2" Background="#FFF8FAFC" CornerRadius="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding AnswersSummary}" FlowDirection="LeftToRight" FontFamily="Consolas" />
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#FF64748B" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14" FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="95" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FFF8FAFC" CornerRadius="8" Padding="10">
                        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" TextAlignment="Right" FontSize="16" />
                    </Border>
                    <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,8">
                        <board:ChessBoardControl x:Name="TrainerBoard"
                                                 Width="680"
                                                 Height="680"
                                                 Position="{Binding BoardFen}"
                                                 Skin="{Binding SelectedSkin}"
                                                 Orientation="{Binding Orientation}"
                                                 ShowCoordinates="{Binding ShowCoordinates}"
                                                 LegalMoves="{Binding LegalMoves}"
                                                 Overlay="{Binding BoardOverlay}"
                                                 MoveRequested="OnMoveRequested"
                                                 PositionRejected="OnPositionRejected" />
                    </Viewbox>
                    <Border Grid.Row="2" Background="#FFF8FAFC" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" TextAlignment="Right" Foreground="#FF9F1239" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" TextAlignment="Right" Foreground="#FF0369A1" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Panel}" FlowDirection="RightToLeft">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="ساخت و تنظیم موقعیت" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="عنوان دوره" Margin="0,12,0,4" />
                        <TextBox Text="{Binding CourseTitle, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAuthoring}" />
                        <TextBlock Text="سمت تمرین" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding TrainerSides}"
                                  SelectedItem="{Binding SelectedSide}"
                                  IsEnabled="{Binding IsAuthoring}" />
                        <TextBlock Text="روش زمان‌بندی" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding ScheduleModes}"
                                  SelectedItem="{Binding SelectedScheduleMode}"
                                  IsEnabled="{Binding IsAuthoring}" />
                        <CheckBox Content="پذیرش ترنسپوزیشن"
                                  IsChecked="{Binding AcceptTranspositions}"
                                  IsEnabled="{Binding IsAuthoring}"
                                  Margin="0,10,0,0" />
                        <CheckBox Content="اجازه تلاش دوباره پس از اشتباه"
                                  IsChecked="{Binding AllowRetry}"
                                  IsEnabled="{Binding IsAuthoring}"
                                  Margin="0,7,0,0" />
                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="جدید روزانه" FontSize="11" />
                                <TextBox Text="{Binding DailyNewLimit, UpdateSourceTrigger=LostFocus}"
                                         FlowDirection="LeftToRight" IsEnabled="{Binding IsAuthoring}" />
                            </StackPanel>
                            <StackPanel Margin="4,0">
                                <TextBlock Text="مرور روزانه" FontSize="11" />
                                <TextBox Text="{Binding DailyReviewLimit, UpdateSourceTrigger=LostFocus}"
                                         FlowDirection="LeftToRight" IsEnabled="{Binding IsAuthoring}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="حد جلسه" FontSize="11" />
                                <TextBox Text="{Binding MaxSessionItems, UpdateSourceTrigger=LostFocus}"
                                         FlowDirection="LeftToRight" IsEnabled="{Binding IsAuthoring}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,8,0,0" IsEnabled="{Binding UsesCustomInterval}">
                            <TextBlock Text="فاصله ثابت (روز)" FontSize="11" />
                            <TextBox Text="{Binding CustomIntervalDays, UpdateSourceTrigger=LostFocus}"
                                     FlowDirection="LeftToRight" IsEnabled="{Binding IsAuthoring}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" IsEnabled="{Binding UsesCyclicalRepetitions}">
                            <TextBlock Text="چرخه (روز)" FontSize="11" />
                            <TextBox Text="{Binding CyclicalRepetitions, UpdateSourceTrigger=LostFocus}"
                                     FlowDirection="LeftToRight" IsEnabled="{Binding IsAuthoring}" />
                        </StackPanel>
                        <TextBlock Text="متن سؤال" Margin="0,12,0,4" />
                        <TextBox Text="{Binding SelectedEditor.Prompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" IsEnabled="{Binding IsAuthoring}" />
                        <TextBlock Text="بازخورد حرکت اشتباه" Margin="0,12,0,4" />
                        <TextBox Text="{Binding SelectedEditor.WrongMoveFeedback, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" IsEnabled="{Binding IsAuthoring}" />
                        <TextBlock Text="اولویت ۰ تا ۱۰۰" Margin="0,12,0,4" />
                        <TextBox Text="{Binding SelectedEditor.Priority, UpdateSourceTrigger=LostFocus}"
                                 FlowDirection="LeftToRight" IsEnabled="{Binding IsAuthoring}" />
                        <TextBlock Text="پاسخ‌های پذیرفته‌شده" Margin="0,12,0,4" />
                        <TextBox Text="{Binding SelectedEditor.AcceptedMovesEditor, UpdateSourceTrigger=PropertyChanged}"
                                 FlowDirection="LeftToRight" FontFamily="Consolas"
                                 AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90"
                                 HorizontalScrollBarVisibility="Auto" IsEnabled="{Binding IsAuthoring}" />
                        <TextBlock Text="هر خط: uci|primary/alternate/soft_fail|feedback"
                                   FontSize="10" Foreground="#FF64748B" FlowDirection="LeftToRight" />
                        <TextBlock Text="راهنماها" Margin="0,12,0,4" />
                        <TextBox Text="{Binding SelectedEditor.HintsEditor, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                                 IsEnabled="{Binding IsAuthoring}" />
                        <TextBlock Text="هر خط: text|penalty|متن راهنما"
                                   FontSize="10" Foreground="#FF64748B" FlowDirection="LeftToRight" />
                        <Separator Margin="0,16" />
                        <Button Content="نمایش راهنمای بعدی" Command="{Binding ShowHintCommand}" />
                        <TextBlock Text="آمار این دوره" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <TextBlock Text="{Binding Stats}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF18181B" CornerRadius="8" Padding="9" Margin="0,9,0,0">
            <TextBlock Text="{Binding Status}" Foreground="#FFF4F4F5" TextWrapping="Wrap" TextAlignment="Right" />
        </Border>
    </Grid>
</Window>
